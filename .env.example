# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# --- Required ---
# Your OpenAI API key (https://platform.openai.com/api-keys).
# Required even when answering with Claude, because the "auto" router uses an
# OpenAI classifier model.
OPENAI_API_KEY=sk-your-key-here

# --- Optional: Anthropic / Claude ---
# Only needed if you point a tier below at a Claude model (any model whose name
# starts with "claude", e.g. claude-sonnet-5). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional: other providers (via LiteLLM) ---
# A tier may also be a provider-prefixed model routed through LiteLLM, e.g.
#   OPENAI_MODEL_SMART=gemini/gemini-flash-latest   (use the -latest aliases;
#                                                    dated Gemini IDs may be gated)
#   OPENAI_MODEL_SMART=mistral/mistral-large-latest
#   OPENAI_MODEL_SMART=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
#   OPENAI_MODEL_SMART=openrouter/anthropic/claude-3.5-sonnet
# Set that provider's standard credential (uncomment what you use):
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OpenRouter (https://openrouter.ai) proxies most major model families
# through one API/key, including a set of genuinely ":free"-suffixed models
# (priced at $0 by this app regardless of MODEL_PRICING) that are natural
# FREE_TIER_MODELS entries above -- e.g.
#   FREE_TIER_MODELS=openrouter/meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=
# Bedrock uses AWS credentials and also requires `pip install boto3`:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# --- Model routing ---
# The orchestrator routes each request to a tier based on task difficulty.
# For the router to be effective, these MUST point at genuinely different
# models — otherwise routing is a no-op that only adds a classifier call.
# Any tier below may be a Claude model (e.g. OPENAI_MODEL_SMART=claude-sonnet-5)
# or a LiteLLM provider-prefixed model (gemini/..., bedrock/..., mistral/..., etc.);
# it is dispatched automatically. The router itself must stay an OpenAI model.

# Base/default model. Used as the fallback default if a tier below is unset.
OPENAI_MODEL=gpt-5

# Cheap, fast classifier used in "auto" mode to pick a tier. Keep this small.
OPENAI_MODEL_ROUTER=gpt-5-nano

# Auto-mode pre-gate: a free heuristic that skips the classifier call above for
# obvious prompts (a bare greeting -> fast, a fenced code block -> smart), so
# they answer instantly. It only decides the tier and stands down whenever a
# MODEL_<CATEGORY> override is set (routing then needs the classifier). Set to
# "false" to always classify.
ROUTER_PREFILTER=true

# Optional cheapest tier for bulk / low-stakes work, BELOW fast. Opt-in: leave
# unset and it's disabled (auto mode never uses it, behaviour unchanged). When
# set, "auto" routes low-complexity fast-category tasks (and bare greetings) here
# instead of the fast tier — e.g. an open-weight model on a Western host:
#   OPENAI_MODEL_BUDGET=groq/llama-3.3-70b-versatile
# Or a truly ZERO-COST local model via Ollama (https://ollama.com — install,
# then `ollama pull llama3.1:8b`; no API key, costs report as $0, and the
# daily budget cap is neither consumed by nor ever blocks free calls):
#   OPENAI_MODEL_BUDGET=ollama/llama3.1:8b
# LiteLLM talks to Ollama at http://localhost:11434 by default; set
# OLLAMA_API_BASE if yours runs elsewhere. Caveat: Ollama's *-cloud tags
# (e.g. ollama/gpt-oss:120b-cloud) are proxied to Ollama's usage-METERED
# cloud — they are NOT auto-priced at $0; add a MODEL_PRICING entry if used.
# It composes with DAILY_BUDGET_USD to stretch the daily cap further. You can
# also force it per request (mode="budget") or pin a conversation to it.
#
# Or ANY other local OpenAI-compatible server (LM Studio, vLLM, llama.cpp
# server, ...) via LOCAL_ENDPOINTS below — same $0/no-budget-cap treatment,
# not limited to Ollama specifically:
#   LOCAL_ENDPOINTS={"lmstudio": "http://localhost:1234/v1"}
#   OPENAI_MODEL_BUDGET=local:lmstudio/llama-3.1-8b-instruct
OPENAI_MODEL_BUDGET=

# Named local OpenAI-compatible inference servers for the "local:<name>/..."
# model scheme above -- JSON map {"name": "http://host:port/v1"}. Empty
# (default) = the local: scheme resolves nothing (LiteLLM raises its own
# provider-not-found error rather than silently misrouting).
LOCAL_ENDPOINTS=

# Simple tasks (quick facts, chat, summaries, reformatting). Cheaper/faster.
OPENAI_MODEL_FAST=gpt-5-mini

# Hard tasks (coding, debugging, reasoning, planning, math, analysis).
OPENAI_MODEL_SMART=gpt-5

# Used when the primary model call fails. For real resilience, point this at a
# DIFFERENT PROVIDER (e.g. OPENAI_MODEL_FALLBACK=claude-sonnet-5, needs
# ANTHROPIC_API_KEY): the fallback chain tries cross-provider candidates first,
# so a provider-wide OpenAI outage doesn't take down the fallback too. Rate-limit
# / quota errors (429) now fail over as well, but ONLY to a different provider —
# the same throttled key would just be rejected again. A same-vendor fallback
# like gpt-5-mini still covers model-specific failures (timeouts, 5xx, bad model).
OPENAI_MODEL_FALLBACK=gpt-5-mini

# --- Token budgets (optional) ---
# Max output tokens per tier. These include model reasoning tokens, so they
# need headroom. Defaults shown. (BUDGET applies only when OPENAI_MODEL_BUDGET
# is set.)
BUDGET_MAX_OUTPUT_TOKENS=800
FAST_MAX_OUTPUT_TOKENS=1500
SMART_MAX_OUTPUT_TOKENS=4000

# --- Per-task-category models (optional) ---
# The heart of the orchestrator: in "auto" mode the router classifies each
# request into a task category, and if that category has a model set here, the
# request goes to it (across any provider) — otherwise it uses the fast/smart
# tier above. This is how you send each kind of task to the model best at it.
# The tier (fast/smart) still sets the token budget + reasoning effort.
# Categories: quick_fact, casual_chat, summarization, simple_transform,
#             coding, debugging, reasoning, planning, math, analysis, creative_writing
# These can also be edited at runtime from the app's Settings panel (or the
# /v1/settings API) without restarting; a value saved there overrides the
# matching env var below. See ALLOW_SETTINGS_WRITE to lock that down.
#
# A strong "best model per task" starting point (needs the matching keys above;
# uncomment and edit to taste). Anything left unset uses the fast/smart tier.
#   Claude for code + reasoning + writing:
# MODEL_CODING=claude-sonnet-5
# MODEL_DEBUGGING=claude-sonnet-5
# MODEL_REASONING=claude-sonnet-5
# MODEL_PLANNING=claude-sonnet-5
# MODEL_CREATIVE_WRITING=claude-sonnet-5
#   OpenAI for math + analysis:
# MODEL_MATH=gpt-5
# MODEL_ANALYSIS=gpt-5
#   Fast + free for trivial tasks:
# MODEL_QUICK_FACT=groq/llama-3.3-70b-versatile
# MODEL_CASUAL_CHAT=groq/llama-3.3-70b-versatile
# MODEL_SUMMARIZATION=gemini/gemini-flash-lite-latest
# MODEL_SIMPLE_TRANSFORM=gemini/gemini-flash-lite-latest

# CATEGORY_PROMPT_<CATEGORY>: an optional role/system prompt for one task
# category, folded into the outgoing prompt whenever auto mode resolves that
# category — e.g. a coder persona for coding requests. Empty (no role prompt)
# for every category by default; same override > env > default chain and
# runtime Settings-panel editability as MODEL_<CATEGORY> above. Capped at
# 4,000 characters, same as a per-conversation custom-instructions field.
# CATEGORY_PROMPT_CODING="You are a senior software engineer. Prefer correct, idiomatic code over cleverness; call out tradeoffs instead of silently picking one."
# CATEGORY_PROMPT_CREATIVE_WRITING="You are a skilled fiction writer. Favor vivid, concrete detail over generic description."

# --- Cost estimates (optional) ---
# Each answer reports tokens used and an estimated USD cost. Prices are built in
# for the common models (approximate — they change often). Override or add
# prices with a JSON map of {"model": [usd_per_1M_input, usd_per_1M_output]} — or
# add a 3rd value for the discounted cached-input rate:
# MODEL_PRICING={"gpt-5": [1.25, 10.0, 0.125], "claude-sonnet-5": [3.0, 15.0]}
#
# Prompt tokens the provider served from its own cache (OpenAI reports these) are
# billed at the model's cached rate above, or — if none is given — at the input
# rate times this multiplier. Default 0.1 (cached input ~= a tenth of input).
CACHED_INPUT_MULTIPLIER=0.1

# --- Daily spend cap (optional) ---
# A global kill-switch on AI spend. Set a positive USD amount to cap total spend
# across all users per UTC calendar day. Once the next call's worst-case cost
# would push today's total past this limit, the call is refused BEFORE any model
# runs (the answer returns empty with an explanatory note; streaming returns an
# error frame). Every billable call is counted — including empty/truncated
# reasoning calls that aren't saved as messages. GET /v1/status reports only
# whether a cap is active (live spend figures are withheld from that public,
# unauthenticated endpoint; the operator sees them in the logs). Unset or 0
# disables the cap (no overhead).
DAILY_BUDGET_USD=

# Same kill-switch, scoped to one caller's own spend (spend_log's `owner`
# column) instead of everyone's combined total — so one user maxing out their
# own budget doesn't starve everyone else's, and vice versa. Independent of
# DAILY_BUDGET_USD above: either, both, or neither can be set, and both are
# checked atomically together when both are configured. Applies to the
# shared/unowned bucket too (static-token or no-auth deployments), where it's
# simply redundant with the global cap unless set tighter than it. Unset or 0
# disables it.
DAILY_BUDGET_PER_OWNER_USD=

# --- Web search retrieval (optional) ---
# Grounds answers in live web results for freshness-sensitive questions (news,
# prices, scores, weather, "latest"/"current" real-world events) — the
# Perplexity-style feature. Uses the OpenAI Responses API's hosted web_search
# tool: NO NEW KEY OR ACCOUNT NEEDED, it bills through your existing
# OPENAI_API_KEY (a small per-search fee on top of the model call — see
# https://platform.openai.com/docs/pricing). Opt-in: unset/false = fully off,
# routing behaviour unchanged (the signal is still computed by the classifier
# but never acted on).
#
# In "auto" mode the classifier flags each question with a needs_live_data
# signal (it explicitly does NOT fire for "the current file"/"the latest
# commit" — only real-world freshness). Only ever engages when the RESOLVED
# model is OpenAI-served: a request routed to Claude/Gemini/LiteLLM never gets
# it, even if the question needs live data. Citations are returned as a
# `sources: [{"title", "url"}]` field on the answer and are never written to
# the response cache (a cached "current" answer would go stale).
WEB_SEARCH=false

# --- Actions/webhooks (optional) ---
# Lets the model PROPOSE a real-world action (send an email, add a row to a
# sheet, post a message, ...) that a human then explicitly confirms or
# declines in the UI before anything happens — propose-then-confirm, never
# autonomous. On confirm, {"action", "payload"} is POSTed to whichever
# webhook below the action resolves to. Every destination is fixed by YOU,
# the operator, ahead of time — never chosen by the model or the end user
# (it can only pick an action NAME, never a URL) — so there's no SSRF
# surface here, only the payload contents are model-influenced. Opt-in:
# both unset = the propose_action tool is never offered to the model, so
# the feature is fully dormant. Like web search, only ever engages when
# the resolved model is OpenAI-served.
#
# The catch-all/fallback URL every action posts to unless ACTIONS_WEBHOOKS
# below names it specifically (or the only route, if that's all you set —
# the original single-webhook behavior).
ACTIONS_WEBHOOK_URL=
# JSON map of {"action_name": "url", ...} routing specific action types to
# their OWN webhook (e.g. a different Zap/Make scenario per action) instead
# of every action type sharing one destination. When set, the model is
# restricted to proposing only these action names. Example:
# ACTIONS_WEBHOOKS={"send_email": "https://hooks.zapier.com/.../email", "update_sheet": "https://hook.make.com/.../sheet"}
ACTIONS_WEBHOOKS=

# --- Image generation (optional) ---
# Lets the model generate images (e.g. "draw me a cat wearing a hat"). Two
# interchangeable backends, picked by IMAGE_GENERATION_MODEL's prefix (same
# "prefix picks the provider" convention as OPENAI_MODEL_FAST etc.):
#
#  - gpt-image-1 (default) — OpenAI's hosted image_generation tool: NO NEW KEY
#    NEEDED, bills through OPENAI_API_KEY. Offered to the model as a tool; the
#    model itself decides when an image is warranted (same as propose_action).
#    Only ever engages when the resolved TEXT model is OpenAI-served.
#  - gemini/imagen-4.0-generate-001 (or another Gemini/Imagen model) — routed
#    through LiteLLM, bills through your existing GEMINI_API_KEY. Gemini has no
#    equivalent of a tool a chat model can call itself, so this path is instead
#    triggered by a narrow phrase heuristic ("draw me", "generate an image
#    of", ...) checked directly against the question — and unlike the OpenAI
#    path, it fires independent of which model is resolved for the text
#    answer (it's a separate call, not a tool that model invokes).
#
# Opt-in: unset/false = fully off either way. Generated images come back as
# `images: ["data:image/png;base64,..."]` on the answer (and persist with the
# message); a message with generated images is never written to the response
# cache (it has no column to store them).
IMAGE_GENERATION=false
IMAGE_GENERATION_MODEL=gpt-image-1
# "low" | "medium" | "high" | "auto". Default "high" — once you've opted in,
# best-effort quality is the point; lower this for a cost-sensitive deployment.
# OpenAI-only; Gemini has no quality param and silently ignores this.
IMAGE_GENERATION_QUALITY=high
# "auto" | "1024x1024" | "1024x1536" | "1536x1024" (or a model-specific custom
# size). Default "auto" (the model picks).
IMAGE_GENERATION_SIZE=auto
# Approximate USD cost per generated image, added to the answer's cost_usd,
# the daily spend log, AND (worst-case, assuming one image) DAILY_BUDGET_USD's
# pre-dispatch check. Unset uses a rough per-quality estimate (this isn't
# token-based, so it can't come from MODEL_PRICING) — override with the exact
# figure for your configured provider/model/quality/size (OpenAI's pricing:
# https://platform.openai.com/docs/pricing; Gemini/Imagen's:
# https://ai.google.dev/gemini-api/docs/pricing).
IMAGE_GENERATION_COST_USD=

# --- Code execution (optional) ---
# Lets the model run Python via a hosted sandbox to verify a calculation or
# test a snippet instead of reasoning its way to an answer it can't check.
# Runs in the provider's own container, NEVER on this machine — same trust
# boundary as web search/image generation. NO NEW KEY needed for either
# provider: OpenAI's code_interpreter bills through OPENAI_API_KEY, Anthropic's
# beta code_execution bills through ANTHROPIC_API_KEY. Offered to the model as
# a tool; the model itself decides when running code would help. Engages for
# both an OpenAI-served and an Anthropic-served resolved model.
#
# Opt-in: unset/false = fully off. Executed code comes back as
# `code_results: [{"code", "logs", "images"}]` on the answer (and persists
# with the message; a Claude-generated image is downloaded via Anthropic's
# Files API and inlined as a data URL, same shape as OpenAI's); a message
# with executed code is never written to the response cache (it has no
# column to store it).
CODE_EXECUTION=false
# Approximate flat USD cost per code execution call, added to the answer's
# cost_usd, the daily spend log, AND DAILY_BUDGET_USD's pre-dispatch check.
# Not token-based, so it can't come from MODEL_PRICING — override with the
# exact figure (see OpenAI's pricing: https://platform.openai.com/docs/pricing).
CODE_EXECUTION_COST_USD=0.03

# --- Moderation (optional) ---
# Runs OpenAI's moderation endpoint on the incoming question before any
# budget reservation or model call — an independent safety-net check on what
# the user SENT, not on what a model decides to say (nothing else in this app
# provides that: routing/answering never second-guesses a model's own output).
# NO NEW KEY needed, bills through OPENAI_API_KEY, no extra token cost.
# OpenAI-only: it's the one provider whose SDK exposes a dedicated moderation
# endpoint, so this runs regardless of which provider ends up answering.
#
# Opt-in: unset/false = fully off. A flagged question is refused before any
# model call or budget spend, with the flagged category names in `notes`.
MODERATION=false
# The moderation model MODERATION uses.
MODERATION_MODEL=omni-moderation-latest

# --- Fact-check lookup (optional) ---
# A question that reads as asking to verify a claim ("fact check: ...",
# "is it true that...", "debunk...", "true or false: ...") triggers a lookup
# against Google's Fact Check Tools API, surfacing up to 5 published
# fact-checks (Snopes, PolitiFact, Reuters Fact Check, ...) as
# `fact_checks: [{"claim", "rating", "publisher", "url"}]` on the answer.
# Independent of which model answers — a standalone call gated by a phrase
# heuristic, same design as the Gemini/Imagen image-generation path, since
# neither OpenAI nor Anthropic offers a hosted tool for this and this app
# has no client-side tool-execution loop to hand a model a tool that isn't
# hosted server-side by the provider. Genuinely different from web search:
# this queries a structured database of claims already reviewed by
# professional fact-checkers rather than general page content the model has
# to interpret itself.
#
# Opt-in: unset/false = fully off. Needs GOOGLE_FACT_CHECK_API_KEY below to
# actually return anything — without it, the lookup silently finds nothing
# rather than erroring. No LLM tokens involved either way. A message with
# fact-check results is never written to the response cache.
FACT_CHECK=false
# API key for Google's Fact Check Tools API (free) — get one at
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=

# --- Academic search lookup (optional) ---
# A question that reads as asking for scholarly literature ("papers on...",
# "studies about...", "academic research on...", "peer-reviewed...")
# triggers a lookup against OpenAlex (free, no API key ever required),
# surfacing up to 5 matching works as `academic_results: [{"title",
# "authors", "year", "venue", "citation_count", "url",
# "abstract_snippet"}]` on the answer. Same standalone-call-gated-by-a-
# phrase-heuristic design as FACT_CHECK above; deliberately excludes the
# bare word "research" ("research my competitors" does not trigger it).
#
# Opt-in: unset/false = fully off. No LLM tokens involved, no key needed. A
# message with academic-search results is never written to the response
# cache.
ACADEMIC_SEARCH=false

# --- Self-description (optional) ---
# Offers the model an app_capabilities tool for a "what can you do / what
# models do you use / do you support X" style question — same cross-provider
# function/custom-tool pattern as MATH_SOLVE (OpenAI function tool, Anthropic
# custom tool-use), so the MODEL decides when a question is really about the
# app, not a phrase list. A LiteLLM-routed model (no native tool-calling
# wired up here) falls back to a phrase heuristic instead. A call executes
# immediately and the REAL configured state (version, effective model map,
# enabled feature flags, known request limits, your remaining per-owner
# budget, free-lane quota status) is appended to the answer as a verified
# note. Also available directly via GET /v1/capabilities.
#
# Opt-in: unset/false = fully off. No LLM tokens involved in computing the
# snapshot itself. A message where the tool was actually called is never
# written to the response cache (the note reflects live, per-owner state).
SELF_DESCRIBE=false

# --- Precision math (optional) ---
# Offers the model a math_solve tool for an exact, verified algebra/calculus
# result via a real symbolic math engine (SymPy) instead of computing one
# itself and risking an error — solve/simplify/differentiate/integrate/
# evaluate. Free, local, ZERO LLM tokens, no external API or key needed.
# Cross-provider from the start: OpenAI's Responses API function tool and
# Anthropic's Messages API custom tool-use, same JSON schema either way.
# Unlike ACTIONS_WEBHOOK_URL's propose_action, a call is executed
# IMMEDIATELY (no confirmation step) since the computation has no
# real-world side effects — the result is folded straight into the answer,
# same "auto-run, result inline" shape as CODE_EXECUTION, just without a
# hosted sandbox (this app's own process runs the computation in-process).
#
# `expression` is untrusted model output, so it's defended in three
# independent layers before it ever reaches the parser: a strict character
# allowlist (no quotes/brackets/backticks/semicolons — the entire string-
# literal-based injection surface a real math expression never needs), a
# keyword denylist (import/exec/eval/os./__/...), and an evaluation
# namespace with Python's own builtins explicitly stripped. See
# app/math_solve.py's module docstring for the full threat model.
#
# Opt-in: unset/false = fully off (the model never even sees the tool).
# Each call comes back as `math_results:
# [{"operation","expression","variable","result","error","source"}]` on the
# answer and persists with the message; a message with a math result is
# never written to the response cache.
MATH_SOLVE=false
# Optional fallback: when SymPy fails to parse/compute an expression that
# already passed every safety check above, and this key is set, solve_math()
# queries Wolfram Alpha's Short Answers API instead of just reporting an
# error. Never offered a security-rejected expression. Entirely optional —
# math_solve works the same as before with this unset, just without the
# fallback. Get a free AppID at https://developer.wolframalpha.com/
WOLFRAM_ALPHA_APP_ID=

# --- Image cost reduction (optional, ON by default) ---
# Two automatic, no-user-decision transforms applied to attached images before
# they're sent to a model (never touching what's persisted with the message):
#  - IMAGE_DOWNSCALE: resize a large attachment down to a bounded resolution
#    before sending, since vision APIs tokenize roughly proportional to pixel
#    count. Skipped if already at/under the cap.
#  - OCR_REPLACEMENT: locally run Tesseract OCR on an attachment; if the
#    extracted text is confident and dense enough, send that text instead of
#    the image entirely (usually far cheaper than image tokens for the same
#    content). Requires Tesseract installed locally (the `tesseract` binary,
#    NOT just the pytesseract Python package) — silently no-ops otherwise.
# Both are skipped entirely (full-quality image sent, unmodified) whenever the
# question implies fine detail matters ("read the small text", "zoom in",
# "exact wording", ...). Unlike the tool flags above, these default to TRUE —
# they only ever reduce what a vision call costs, so they're opt-out, not
# opt-in. Both are also editable at runtime from the Settings panel.
IMAGE_DOWNSCALE=true
OCR_REPLACEMENT=true
# Longest edge, in pixels, a downscaled image is resized to fit within.
# Default shown.
IMAGE_DOWNSCALE_MAX_DIMENSION=1024
# Path to the tesseract binary, if it's not on PATH (e.g. a custom install on
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe). Leave unset to use
# whatever `tesseract` resolves to on PATH.
TESSERACT_CMD=

# --- Concise answers (optional, OFF by default) ---
# Appends a brevity instruction to the outgoing prompt ("no preamble, no
# filler, no hedging, prefer bullet points/short paragraphs over prose") for
# every answer. Output tokens typically bill 3-10x the input rate, so a
# terser answer is usually the single biggest per-call cost lever available.
# Unlike IMAGE_DOWNSCALE/OCR_REPLACEMENT above, this changes what the model
# actually SAYS rather than just what it's billed for, so it defaults to
# off — opt-in, not opt-out. Editable at runtime from the Settings panel.
CONCISE_MODE=false

# --- Voice input (always on; no key needed beyond OPENAI_API_KEY) ---
# The mic button in the UI records a clip and POSTs it to /v1/transcribe,
# which calls OpenAI's transcription API. No opt-in flag: this is a discrete,
# explicitly user-triggered action (click record, speak, click stop), not
# something the chat flow or the model decides to do, so it's trusted at the
# same level as the ask endpoint itself.
# gpt-4o-transcribe for higher quality, whisper-1 for the classic model.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Flat estimated USD cost per call, used to gate /v1/transcribe against
# DAILY_BUDGET_USD and to record it in the spend log. Whisper-class
# transcription bills per minute of audio, which isn't known before decoding
# the clip, so this is a rough flat estimate rather than an exact rate.
TRANSCRIPTION_COST_PER_CALL_USD=0.006

# --- Voice output (always on; no key needed beyond OPENAI_API_KEY) ---
# The 🔊 button on an assistant message POSTs its text to /v1/speak, which
# calls OpenAI's TTS API and returns raw audio/mpeg bytes for the browser to
# play. Same trust level as voice input — no opt-in flag.
# tts-1-hd for higher quality than the default.
SPEECH_MODEL=gpt-4o-mini-tts
# See https://platform.openai.com/docs/guides/text-to-speech#voice-options
# for the full voice list.
SPEECH_VOICE=alloy
# Estimated USD cost per 1,000 input characters, used to gate /v1/speak
# against DAILY_BUDGET_USD and to record it in the spend log. OpenAI TTS
# bills per character, not per LLM token, so this can't come from MODEL_PRICING.
SPEECH_COST_PER_1K_CHARS_USD=0.015

# --- Response cache (optional) ---
# Cache answers so an identical prompt (same mode + model config) returns
# instantly and for free, with no model call. Set to "false" to disable.
RESPONSE_CACHE=true
# Entry lifetime in seconds; 0 (default) means entries never expire.
RESPONSE_CACHE_TTL_SECONDS=0
# Max stored entries before the least-recently-used are evicted (0 = unbounded).
RESPONSE_CACHE_MAX_ENTRIES=1000

# --- Semantic (paraphrase) cache (optional, OFF by default) ---
# An ADDITIONAL layer on top of the exact-match response cache above: catches
# a paraphrased repeat ("what's the capital of France?" vs "capital of
# france?") via OpenAI embedding similarity (no new key — bills through
# OPENAI_API_KEY; embeddings are negligible cost, priced like the router
# classifier/summarizer — an uncapped, uncounted auxiliary call). Only ever
# applied to a CONTEXT-FREE question (no conversation history, no custom
# system prompt behind it) — once a conversation has history, two
# similar-sounding prompts can still imply different answers (different
# history = different referents), so semantic matching is never even offered
# a context-bearing prompt. See app/semantic_cache.py for the full design
# rationale. Off by default: a wrong semantic hit (serving a plausible-but-
# different answer) is worse than a miss, unlike the exact cache, where a
# wrong hit can't happen by construction — this needs an explicit opt-in.
# Editable at runtime from the Settings panel like any other feature flag.
SEMANTIC_CACHE=false
# Minimum cosine similarity (0-1) to count as a match. Deliberately
# conservative by default — widen only after confirming on your own traffic
# that it isn't producing wrong hits.
SEMANTIC_CACHE_THRESHOLD=0.96
# Cap on stored embeddings; lookups are a brute-force cosine scan over every
# entry (no vector DB dependency), so this is kept small on purpose.
SEMANTIC_CACHE_MAX_ENTRIES=200
# OpenAI embeddings model used for both indexing and lookup.
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small

# --- Cross-conversation memory (optional, OFF by default) ---
# A NEW turn on any conversation can recall relevant exchanges from the same
# owner's OTHER conversations too, via OpenAI embedding similarity (no new
# key — bills through OPENAI_API_KEY), folded into the prompt as extra
# context the model uses its own judgment on. Same "no vector DB, brute-force
# cosine scan" design as the semantic cache above, reusing its embed()/
# cosine-similarity helpers directly — but a genuinely different concern:
# this never serves a cached answer, it only recalls PAST EXCHANGES as
# context, the same way a conversation's own "Summary of earlier messages"
# already works, just reaching across conversation boundaries. Deliberately
# a softer guarantee than the semantic cache's exact-answer reuse (a false
# positive here just adds a possibly-irrelevant snippet, not a wrong answer
# served outright), so the threshold below is much looser. See
# app/memory.py for the full design rationale. Scoped to the main ask/
# ask-stream endpoints only (not regenerate/edit, not the stateless
# /v1/ask), and always excludes the asking conversation's own entries.
# Editable at runtime from the Settings panel like any other feature flag.
CROSS_CONVERSATION_MEMORY=false
# Minimum cosine similarity (0-1) to count as relevant enough to recall.
# Looser than SEMANTIC_CACHE_THRESHOLD on purpose — see rationale above.
MEMORY_THRESHOLD=0.794
# Maximum number of past exchanges folded into one turn's prompt.
MEMORY_TOP_K=3
# Cap on stored entries PER OWNER (not global, unlike the semantic cache —
# this is meant to grow with one user's real conversation history over
# time); lookups are a brute-force cosine scan, kept small on purpose.
# Oldest evicted first once exceeded.
MEMORY_MAX_ENTRIES=500

# --- RAG document library (optional, OFF by default) ---
# A per-owner library of persistent reference documents (PDF or plain text)
# the model can automatically draw on across every conversation, distinct
# from a per-message attachment which only exists for that one turn. A new
# turn embeds the question, recalls the best-matching chunks (same "no
# vector DB, brute-force cosine scan" design as cross-conversation memory
# above), and folds them into the prompt with source filenames included.
# See app/rag_library.py for the full design rationale. Manage documents via
# the header's Library modal or POST/GET/DELETE /v1/library/documents.
# Editable at runtime from the Settings panel like any other feature flag.
RAG_LIBRARY=false
# Minimum cosine similarity (0-1) to count as relevant enough to recall.
# Looser than MEMORY_THRESHOLD on purpose — a document chunk is a narrower,
# more literal piece of text to match against than a whole past exchange.
RAG_MIN_SIMILARITY=0.30
# Maximum number of document chunks folded into one turn's prompt.
RAG_TOP_K=4

# --- Opt-in multi-step workflow mode (mode: "workflow"; never the default) ---
# A cheap planning call decomposes the request into focused sub-instructions
# (each run through the ordinary single-ask pipeline) plus a synthesis step.
# See app/workflow.py for the full design rationale. Plain env vars — not
# part of the Settings-panel override chain, same as RAG_TOP_K/MEMORY_TOP_K.
# Max planned steps, not counting the always-present synthesis step. Clamped
# to a hard ceiling of 6 regardless of this value.
WORKFLOW_MAX_STEPS=4
# Output ceiling for a workflow step that must PRODUCE A FILE. Its own setting
# rather than a tier's, because it sizes a different kind of output: a tier cap
# sizes prose a person reads, while an artefact step emits code carrying every
# row of the data. Well above the smart tier's 4000 on purpose — a spreadsheet
# of a few dozen rich rows does not fit in a text budget, and the failure mode
# is a file that stops mid-structure while looking finished. Only ever RAISES a
# step's ceiling, so lowering it cannot shrink a tier that already allows more.
ARTEFACT_MAX_OUTPUT_TOKENS=8000
# Let the ROUTER pick workflow mode by itself, for a request that asks for
# several distinct artefacts in one turn ("write the summary, build the
# spreadsheet, and chart the result"). OFF by default. Costs no extra model
# call: the verdict rides the classification the router already makes, and is
# only even asked for when the question contains a production verb plus a
# clause joiner — an ordinary question never sees the extra fields. Firing
# wrongly is the expensive direction (several model calls instead of one), so
# it is biased hard against: several TOPICS in one prose answer ("compare A
# and B", "analyse this and give recommendations") is not multi-part. Falls
# back to a normal single answer if the plan or the budget reservation fails.
AUTO_WORKFLOW=false

# --- Self-updating model catalog (optional, OFF by default) ---
# Pulls LiteLLM's published pricing feed (model_prices_and_context_window.json)
# to fill in/refresh MODEL_PRICING-style rates automatically instead of
# relying only on the hand-maintained defaults in app/usage.py. Precedence,
# lowest to highest: this catalog -> the hand-bundled defaults -> your own
# MODEL_PRICING (always wins over both). A model missing from all three
# stays unpriced, same as today. The only thing in this app that ever calls
# a server other than a configured LLM provider — every other network call
# here goes to an API you deliberately pointed the app at — so this is
# opt-in, unlike everything else that's just a cost-estimate detail.
# No background scheduler: a sync only happens when you click "Sync now" in
# Settings, or lazily (at most once per SYNC_INTERVAL_HOURS) the next time
# you open the Settings panel while this is enabled. See
# app/model_catalog.py for the full design rationale. Editable at runtime
# from the Settings panel like any other feature flag.
MODEL_CATALOG_SYNC=false
# How often GET /v1/model-catalog is allowed to trigger an automatic sync.
MODEL_CATALOG_SYNC_INTERVAL_HOURS=24
# Override the feed URL (e.g. to point at a mirror or a pinned commit).
MODEL_CATALOG_FEED_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# --- Rotating periodic DB backups (ON by default) ---
# Periodically copies the whole SQLite database file (a plain shutil.copy2,
# after checkpointing the WAL so the copy is complete) and keeps the most
# recent DB_BACKUP_MAX_COUNT of them, deleting older ones. No background
# scheduler, same "checked lazily on a naturally-frequent request path"
# design as MODEL_CATALOG_SYNC above: the staleness check is cheap and safe
# to run on every GET /v1/conversations (hit every time the sidebar loads),
# and only actually copies the file + rotates on the rare call where a
# backup is actually due. A local file copy, never a network call — unlike
# MODEL_CATALOG_SYNC/FACT_CHECK this defaults ON, the same reasoning as
# IMAGE_DOWNSCALE/OCR_REPLACEMENT (never touches cost or answering
# behavior). Backups land next to the database file itself, named
# "<db file>.backup-<UTC timestamp>" — distinct from the one-off
# "<db file>.bak-v<version>-<timestamp>" migration backup database.py takes
# before a schema change, so rotation here never touches that. Editable at
# runtime from the Settings panel like any other feature flag.
DB_BACKUP=true
# How often a fresh backup is actually taken (hours).
DB_BACKUP_INTERVAL_HOURS=24
# How many backups to keep; the oldest beyond this are deleted on the next backup.
DB_BACKUP_MAX_COUNT=7

# --- Free-first routing (optional, ON by default once configured) ---
# Tries a provider-hosted free-tier model (Gemini's free API tier, Groq's
# free tier, OpenRouter's :free models, ...) BEFORE this app's paid budget/
# fast tier, while a self-tracked daily request quota lasts -- a free-tier
# model costs literally nothing, the same $0 treatment a local Ollama model
# already gets (see OPENAI_MODEL_BUDGET=ollama/... above), except this is a
# real hosted API with a real (if generous) rate limit rather than unlimited
# local compute.
#
# Deliberately NOT hardcoded with today's published free-tier limits: real
# limits vary by provider, change over time, and depend on YOUR account (a
# key that's ever been billed gets different limits than a brand-new one) --
# baking in a number here would be guessing at a value that might not match
# your deployment and would go stale regardless. Set your own.
#
# Comma-separated, in the order to try them. Empty (default) = fully off,
# regardless of FREE_TIER_ROUTING below. Also editable at runtime from the
# Settings panel's "Free-first routing lane" section (a saved override wins
# over this env var).
FREE_TIER_MODELS=
# Requests/day before this app stops routing to a given model for the rest
# of the UTC day -- a self-imposed ceiling to avoid actually hitting the
# provider's real limit (and getting a 429), reset implicitly at midnight
# UTC (no live query against the provider -- most don't expose one). Also
# editable at runtime from the Settings panel.
FREE_TIER_DEFAULT_QUOTA=100
# Per-model override: FREE_TIER_QUOTA_<MODEL>, where <MODEL> is the model
# string uppercased with every non-alphanumeric character turned into an
# underscore. Example for gemini/gemini-flash-latest:
# FREE_TIER_QUOTA_GEMINI_GEMINI_FLASH_LATEST=50
#
# Only ever substitutes for genuinely AUTO-mode fast/budget-tier traffic --
# never an explicit (non-auto) fast/budget/smart request, a configured
# per-category model override, smart-tier (unless FREE_LANE_SMART=true
# below), a forced/switch-model choice (you explicitly picked that exact
# model), or a turn that would use a provider-hosted tool this turn (a
# free-tier model can't be assumed to support the same tools). A dispatch
# failure (including a 429/quota error) falls through to the NEXT configured
# free-tier candidate before the normal paid cross-vendor fallback chain --
# the failed candidate is also cooled down (treated as out of quota) for the
# rest of the UTC day. Editable at runtime from the Settings panel like any
# other feature flag.
FREE_TIER_ROUTING=true
# Also let free-tier routing substitute for smart-tier auto-mode results,
# not just fast/budget. Off by default -- a smart-tier request is one where
# quality was chosen deliberately, so downgrading it needs an explicit
# opt-in. Editable at runtime from the Settings panel.
FREE_LANE_SMART=false

# --- Conversation memory (optional) ---
# Long conversations keep the most recent 12 turns verbatim; everything older is
# folded into a compact summary (one cheap OPENAI_MODEL_ROUTER call before the
# answer) so the model keeps the whole thread's context instead of forgetting it.
# Short conversations (<= 12 prior messages) are untouched and make no extra call.
SUMMARIZE_HISTORY=true
# Max tokens for that summary. Default shown.
SUMMARY_MAX_OUTPUT_TOKENS=600

# --- Reasoning effort (optional) ---
# Per-tier reasoning effort: minimal|low|medium|high. Lower effort makes the
# fast tier answer simple questions much faster. Invalid values fall back to
# the defaults shown.
BUDGET_REASONING_EFFORT=minimal
FAST_REASONING_EFFORT=low
SMART_REASONING_EFFORT=medium

# --- Timeouts (optional) ---
# Per-request timeout for OpenAI answer calls, in seconds. Default shown.
OPENAI_TIMEOUT_SECONDS=120

# --- API auth (optional) ---
# Static bearer token required on /v1/ask and /v1/conversations* endpoints.
# Leave empty to disable static-token auth.
API_AUTH_TOKEN=

# --- User accounts / JWT auth (optional) ---
# Set a signing secret to enable username/password accounts. When set,
# /v1/auth/register and /v1/auth/login become active and JWTs they issue are
# accepted on the protected endpoints (alongside API_AUTH_TOKEN, if also set).
# When logged in via JWT, each user's conversations are private to them; with
# auth off or a static token they share one unowned bucket.
JWT_SECRET=
# Access-token lifetime in days (default 30). This is a self-hosted personal
# app, not a bank -- daily forced sign-ins serve nobody, so the default is
# long-lived on purpose. Existing issued tokens keep whatever lifetime they
# were issued with; changing this only affects the next sign-in.
JWT_EXPIRY_DAYS=30
# Set to "false" to disable the /v1/auth/register endpoint.
ALLOW_REGISTRATION=true

# --- Settings API (optional) ---
# The task->model map is editable at runtime via the Settings panel / the
# /v1/settings endpoints (a saved value overrides the matching env var above).
# The map is GLOBAL, so on a shared/multi-user deployment set this to "false" to
# make the settings read-only (writes return 403); edits then come only from env.
ALLOW_SETTINGS_WRITE=true
# Comma-separated usernames (case-insensitive) — this app's single admin
# definition, shared by Settings and the admin-only user-management API
# (create/reset-password/deactivate/reactivate accounts, and the "Users"
# section in Settings). Leave empty and everything behaves exactly as
# today (solo/family-trusted setup): Settings stays writable by any
# authenticated user while registration is closed, same as always, and the
# user-management API/UI simply isn't usable yet. Set this to opt into a
# real multi-user deployment: every account in ADMIN_USERNAMES can manage
# other accounts and edit Settings, and — unlike before — that gate now
# applies regardless of ALLOW_REGISTRATION (previously it only engaged
# while registration was open). Recommended pairing: ADMIN_USERNAMES set,
# ALLOW_REGISTRATION=false — the operator provisions every account
# themself via the Users section instead of leaving signup open.
ADMIN_USERNAMES=

# --- CORS (optional) ---
# Comma-separated list of allowed browser origins. Default shown.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Remote access safety nudge (optional, informational only) ---
# Doesn't bind anything itself (that's uvicorn's own --host flag) -- set it
# to the same address you passed to --host so this app can warn at startup
# if that's beyond localhost with no auth configured. See docs/remote-access.md.
BIND_HOST=

# --- Rate limiting (optional) ---
# Per-client-IP limit on the ask endpoints, in slowapi syntax (e.g. "60/minute",
# "5/second"). Leave empty to disable rate limiting entirely.
RATE_LIMIT=
# Set "true" ONLY when the backend runs behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. the bundled docker-compose nginx). Then the rate-limit
# key is the forwarded client IP instead of the proxy's. Do not enable if the
# backend is reachable directly — clients could spoof the header.
TRUST_PROXY_HEADERS=false

# Per-client-IP limit on register/login/logout/refresh. Unlike RATE_LIMIT above,
# this one is ALWAYS ON (not gated behind that setting) — a login brute-force or
# registration-spam vector shouldn't depend on an opt-in setting. Default shown;
# only relevant once JWT_SECRET is set (those endpoints 400 otherwise).
AUTH_RATE_LIMIT=5/minute

# --- Observability (optional) ---
# OpenTelemetry tracing is off unless an OTLP/HTTP endpoint is set here. Point it
# at any OTLP collector (SigNoz, Grafana Tempo, Jaeger, an OTel Collector, ...).
# Traces include per-request spans enriched with the routing decision
# (ai.mode_used, ai.model, ai.provider).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-orchestrator

# --- Storage (optional) ---
# SQLite database path. Defaults to ai_orchestrator.db in the project root.
DATABASE_PATH=ai_orchestrator.db
