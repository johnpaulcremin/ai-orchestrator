# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# --- Required ---
# Your OpenAI API key (https://platform.openai.com/api-keys).
# Required even when answering with Claude, because the "auto" router uses an
# OpenAI classifier model.
OPENAI_API_KEY=sk-your-key-here

# --- Optional: Anthropic / Claude ---
# Only needed if you point a tier below at a Claude model (any model whose name
# starts with "claude", e.g. claude-sonnet-5). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional: other providers (via LiteLLM) ---
# A tier may also be a provider-prefixed model routed through LiteLLM, e.g.
#   OPENAI_MODEL_SMART=gemini/gemini-flash-latest   (use the -latest aliases;
#                                                    dated Gemini IDs may be gated)
#   OPENAI_MODEL_SMART=mistral/mistral-large-latest
#   OPENAI_MODEL_SMART=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
# Set that provider's standard credential (uncomment what you use):
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# Bedrock uses AWS credentials and also requires `pip install boto3`:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# --- Model routing ---
# The orchestrator routes each request to a tier based on task difficulty.
# For the router to be effective, these MUST point at genuinely different
# models — otherwise routing is a no-op that only adds a classifier call.
# Any tier below may be a Claude model (e.g. OPENAI_MODEL_SMART=claude-sonnet-5)
# or a LiteLLM provider-prefixed model (gemini/..., bedrock/..., mistral/..., etc.);
# it is dispatched automatically. The router itself must stay an OpenAI model.

# Base/default model. Used as the fallback default if a tier below is unset.
OPENAI_MODEL=gpt-5

# Cheap, fast classifier used in "auto" mode to pick a tier. Keep this small.
OPENAI_MODEL_ROUTER=gpt-5-nano

# Auto-mode pre-gate: a free heuristic that skips the classifier call above for
# obvious prompts (a bare greeting -> fast, a fenced code block -> smart), so
# they answer instantly. It only decides the tier and stands down whenever a
# MODEL_<CATEGORY> override is set (routing then needs the classifier). Set to
# "false" to always classify.
ROUTER_PREFILTER=true

# Optional cheapest tier for bulk / low-stakes work, BELOW fast. Opt-in: leave
# unset and it's disabled (auto mode never uses it, behaviour unchanged). When
# set, "auto" routes low-complexity fast-category tasks (and bare greetings) here
# instead of the fast tier — e.g. an open-weight model on a Western host:
#   OPENAI_MODEL_BUDGET=groq/llama-3.3-70b-versatile
# Or a truly ZERO-COST local model via Ollama (https://ollama.com — install,
# then `ollama pull llama3.1:8b`; no API key, costs report as $0, and the
# daily budget cap is neither consumed by nor ever blocks free calls):
#   OPENAI_MODEL_BUDGET=ollama/llama3.1:8b
# LiteLLM talks to Ollama at http://localhost:11434 by default; set
# OLLAMA_API_BASE if yours runs elsewhere. Caveat: Ollama's *-cloud tags
# (e.g. ollama/gpt-oss:120b-cloud) are proxied to Ollama's usage-METERED
# cloud — they are NOT auto-priced at $0; add a MODEL_PRICING entry if used.
# It composes with DAILY_BUDGET_USD to stretch the daily cap further. You can
# also force it per request (mode="budget") or pin a conversation to it.
OPENAI_MODEL_BUDGET=

# Simple tasks (quick facts, chat, summaries, reformatting). Cheaper/faster.
OPENAI_MODEL_FAST=gpt-5-mini

# Hard tasks (coding, debugging, reasoning, planning, math, analysis).
OPENAI_MODEL_SMART=gpt-5

# Used when the primary model call fails. For real resilience, point this at a
# DIFFERENT PROVIDER (e.g. OPENAI_MODEL_FALLBACK=claude-sonnet-5, needs
# ANTHROPIC_API_KEY): the fallback chain tries cross-provider candidates first,
# so a provider-wide OpenAI outage doesn't take down the fallback too. Rate-limit
# / quota errors (429) now fail over as well, but ONLY to a different provider —
# the same throttled key would just be rejected again. A same-vendor fallback
# like gpt-5-mini still covers model-specific failures (timeouts, 5xx, bad model).
OPENAI_MODEL_FALLBACK=gpt-5-mini

# --- Token budgets (optional) ---
# Max output tokens per tier. These include model reasoning tokens, so they
# need headroom. Defaults shown. (BUDGET applies only when OPENAI_MODEL_BUDGET
# is set.)
BUDGET_MAX_OUTPUT_TOKENS=800
FAST_MAX_OUTPUT_TOKENS=1500
SMART_MAX_OUTPUT_TOKENS=4000

# --- Per-task-category models (optional) ---
# The heart of the orchestrator: in "auto" mode the router classifies each
# request into a task category, and if that category has a model set here, the
# request goes to it (across any provider) — otherwise it uses the fast/smart
# tier above. This is how you send each kind of task to the model best at it.
# The tier (fast/smart) still sets the token budget + reasoning effort.
# Categories: quick_fact, casual_chat, summarization, simple_transform,
#             coding, debugging, reasoning, planning, math, analysis, creative_writing
# These can also be edited at runtime from the app's Settings panel (or the
# /v1/settings API) without restarting; a value saved there overrides the
# matching env var below. See ALLOW_SETTINGS_WRITE to lock that down.
#
# A strong "best model per task" starting point (needs the matching keys above;
# uncomment and edit to taste). Anything left unset uses the fast/smart tier.
#   Claude for code + reasoning + writing:
# MODEL_CODING=claude-sonnet-5
# MODEL_DEBUGGING=claude-sonnet-5
# MODEL_REASONING=claude-sonnet-5
# MODEL_PLANNING=claude-sonnet-5
# MODEL_CREATIVE_WRITING=claude-sonnet-5
#   OpenAI for math + analysis:
# MODEL_MATH=gpt-5
# MODEL_ANALYSIS=gpt-5
#   Fast + free for trivial tasks:
# MODEL_QUICK_FACT=groq/llama-3.3-70b-versatile
# MODEL_CASUAL_CHAT=groq/llama-3.3-70b-versatile
# MODEL_SUMMARIZATION=gemini/gemini-flash-lite-latest
# MODEL_SIMPLE_TRANSFORM=gemini/gemini-flash-lite-latest

# --- Cost estimates (optional) ---
# Each answer reports tokens used and an estimated USD cost. Prices are built in
# for the common models (approximate — they change often). Override or add
# prices with a JSON map of {"model": [usd_per_1M_input, usd_per_1M_output]} — or
# add a 3rd value for the discounted cached-input rate:
# MODEL_PRICING={"gpt-5": [1.25, 10.0, 0.125], "claude-sonnet-5": [3.0, 15.0]}
#
# Prompt tokens the provider served from its own cache (OpenAI reports these) are
# billed at the model's cached rate above, or — if none is given — at the input
# rate times this multiplier. Default 0.1 (cached input ~= a tenth of input).
CACHED_INPUT_MULTIPLIER=0.1

# --- Daily spend cap (optional) ---
# A global kill-switch on AI spend. Set a positive USD amount to cap total spend
# across all users per UTC calendar day. Once the next call's worst-case cost
# would push today's total past this limit, the call is refused BEFORE any model
# runs (the answer returns empty with an explanatory note; streaming returns an
# error frame). Every billable call is counted — including empty/truncated
# reasoning calls that aren't saved as messages. GET /v1/status reports only
# whether a cap is active (live spend figures are withheld from that public,
# unauthenticated endpoint; the operator sees them in the logs). Unset or 0
# disables the cap (no overhead).
DAILY_BUDGET_USD=

# --- Web search retrieval (optional) ---
# Grounds answers in live web results for freshness-sensitive questions (news,
# prices, scores, weather, "latest"/"current" real-world events) — the
# Perplexity-style feature. Uses the OpenAI Responses API's hosted web_search
# tool: NO NEW KEY OR ACCOUNT NEEDED, it bills through your existing
# OPENAI_API_KEY (a small per-search fee on top of the model call — see
# https://platform.openai.com/docs/pricing). Opt-in: unset/false = fully off,
# routing behaviour unchanged (the signal is still computed by the classifier
# but never acted on).
#
# In "auto" mode the classifier flags each question with a needs_live_data
# signal (it explicitly does NOT fire for "the current file"/"the latest
# commit" — only real-world freshness). Only ever engages when the RESOLVED
# model is OpenAI-served: a request routed to Claude/Gemini/LiteLLM never gets
# it, even if the question needs live data. Citations are returned as a
# `sources: [{"title", "url"}]` field on the answer and are never written to
# the response cache (a cached "current" answer would go stale).
WEB_SEARCH=false

# --- Actions/webhooks (optional) ---
# Lets the model PROPOSE a real-world action (send an email, add a row to a
# sheet, post a message, ...) that a human then explicitly confirms or
# declines in the UI before anything happens — propose-then-confirm, never
# autonomous. On confirm, the proposed JSON payload is POSTed to the single
# webhook URL below (e.g. a Zapier "Catch Hook" or Make "Webhooks" trigger).
# The destination is fixed by YOU, the operator — never chosen by the model
# or the end user — so there's no SSRF surface here, only the payload
# contents are model-influenced. Opt-in: unset = the propose_action tool is
# never offered to the model, so the feature is fully dormant. Like web
# search, only ever engages when the resolved model is OpenAI-served.
ACTIONS_WEBHOOK_URL=

# --- Image generation (optional) ---
# Lets the model generate images (e.g. "draw me a cat wearing a hat"). Two
# interchangeable backends, picked by IMAGE_GENERATION_MODEL's prefix (same
# "prefix picks the provider" convention as OPENAI_MODEL_FAST etc.):
#
#  - gpt-image-1 (default) — OpenAI's hosted image_generation tool: NO NEW KEY
#    NEEDED, bills through OPENAI_API_KEY. Offered to the model as a tool; the
#    model itself decides when an image is warranted (same as propose_action).
#    Only ever engages when the resolved TEXT model is OpenAI-served.
#  - gemini/imagen-4.0-generate-001 (or another Gemini/Imagen model) — routed
#    through LiteLLM, bills through your existing GEMINI_API_KEY. Gemini has no
#    equivalent of a tool a chat model can call itself, so this path is instead
#    triggered by a narrow phrase heuristic ("draw me", "generate an image
#    of", ...) checked directly against the question — and unlike the OpenAI
#    path, it fires independent of which model is resolved for the text
#    answer (it's a separate call, not a tool that model invokes).
#
# Opt-in: unset/false = fully off either way. Generated images come back as
# `images: ["data:image/png;base64,..."]` on the answer (and persist with the
# message); a message with generated images is never written to the response
# cache (it has no column to store them).
IMAGE_GENERATION=false
IMAGE_GENERATION_MODEL=gpt-image-1
# "low" | "medium" | "high" | "auto". Default "high" — once you've opted in,
# best-effort quality is the point; lower this for a cost-sensitive deployment.
# OpenAI-only; Gemini has no quality param and silently ignores this.
IMAGE_GENERATION_QUALITY=high
# "auto" | "1024x1024" | "1024x1536" | "1536x1024" (or a model-specific custom
# size). Default "auto" (the model picks).
IMAGE_GENERATION_SIZE=auto
# Approximate USD cost per generated image, added to the answer's cost_usd,
# the daily spend log, AND (worst-case, assuming one image) DAILY_BUDGET_USD's
# pre-dispatch check. Unset uses a rough per-quality estimate (this isn't
# token-based, so it can't come from MODEL_PRICING) — override with the exact
# figure for your configured provider/model/quality/size (OpenAI's pricing:
# https://platform.openai.com/docs/pricing; Gemini/Imagen's:
# https://ai.google.dev/gemini-api/docs/pricing).
IMAGE_GENERATION_COST_USD=

# --- Voice input (always on; no key needed beyond OPENAI_API_KEY) ---
# The mic button in the UI records a clip and POSTs it to /v1/transcribe,
# which calls OpenAI's transcription API. No opt-in flag: this is a discrete,
# explicitly user-triggered action (click record, speak, click stop), not
# something the chat flow or the model decides to do, so it's trusted at the
# same level as the ask endpoint itself.
# gpt-4o-transcribe for higher quality, whisper-1 for the classic model.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Flat estimated USD cost per call, used to gate /v1/transcribe against
# DAILY_BUDGET_USD and to record it in the spend log. Whisper-class
# transcription bills per minute of audio, which isn't known before decoding
# the clip, so this is a rough flat estimate rather than an exact rate.
TRANSCRIPTION_COST_PER_CALL_USD=0.006

# --- Voice output (always on; no key needed beyond OPENAI_API_KEY) ---
# The 🔊 button on an assistant message POSTs its text to /v1/speak, which
# calls OpenAI's TTS API and returns raw audio/mpeg bytes for the browser to
# play. Same trust level as voice input — no opt-in flag.
# tts-1-hd for higher quality than the default.
SPEECH_MODEL=gpt-4o-mini-tts
# See https://platform.openai.com/docs/guides/text-to-speech#voice-options
# for the full voice list.
SPEECH_VOICE=alloy
# Estimated USD cost per 1,000 input characters, used to gate /v1/speak
# against DAILY_BUDGET_USD and to record it in the spend log. OpenAI TTS
# bills per character, not per LLM token, so this can't come from MODEL_PRICING.
SPEECH_COST_PER_1K_CHARS_USD=0.015

# --- Response cache (optional) ---
# Cache answers so an identical prompt (same mode + model config) returns
# instantly and for free, with no model call. Set to "false" to disable.
RESPONSE_CACHE=true
# Entry lifetime in seconds; 0 (default) means entries never expire.
RESPONSE_CACHE_TTL_SECONDS=0
# Max stored entries before the least-recently-used are evicted (0 = unbounded).
RESPONSE_CACHE_MAX_ENTRIES=1000

# --- Conversation memory (optional) ---
# Long conversations keep the most recent 12 turns verbatim; everything older is
# folded into a compact summary (one cheap OPENAI_MODEL_ROUTER call before the
# answer) so the model keeps the whole thread's context instead of forgetting it.
# Short conversations (<= 12 prior messages) are untouched and make no extra call.
SUMMARIZE_HISTORY=true
# Max tokens for that summary. Default shown.
SUMMARY_MAX_OUTPUT_TOKENS=600

# --- Reasoning effort (optional) ---
# Per-tier reasoning effort: minimal|low|medium|high. Lower effort makes the
# fast tier answer simple questions much faster. Invalid values fall back to
# the defaults shown.
BUDGET_REASONING_EFFORT=minimal
FAST_REASONING_EFFORT=low
SMART_REASONING_EFFORT=medium

# --- Timeouts (optional) ---
# Per-request timeout for OpenAI answer calls, in seconds. Default shown.
OPENAI_TIMEOUT_SECONDS=120

# --- API auth (optional) ---
# Static bearer token required on /v1/ask and /v1/conversations* endpoints.
# Leave empty to disable static-token auth.
API_AUTH_TOKEN=

# --- User accounts / JWT auth (optional) ---
# Set a signing secret to enable username/password accounts. When set,
# /v1/auth/register and /v1/auth/login become active and JWTs they issue are
# accepted on the protected endpoints (alongside API_AUTH_TOKEN, if also set).
# When logged in via JWT, each user's conversations are private to them; with
# auth off or a static token they share one unowned bucket.
JWT_SECRET=
# Access-token lifetime in minutes (default 60).
JWT_EXPIRE_MINUTES=60
# Set to "false" to disable the /v1/auth/register endpoint.
ALLOW_REGISTRATION=true

# --- Settings API (optional) ---
# The task->model map is editable at runtime via the Settings panel / the
# /v1/settings endpoints (a saved value overrides the matching env var above).
# The map is GLOBAL, so on a shared/multi-user deployment set this to "false" to
# make the settings read-only (writes return 403); edits then come only from env.
ALLOW_SETTINGS_WRITE=true
# Comma-separated usernames (case-insensitive) allowed to write settings when
# JWT_SECRET is set AND ALLOW_REGISTRATION is open — that's the one
# combination where an anonymous visitor can self-register their own
# credential and would otherwise inherit the same settings-write rights as
# the operator (this app has no other admin/role concept). Closed
# registration or auth-disabled/static-token deployments are unaffected.
ADMIN_USERNAMES=

# --- CORS (optional) ---
# Comma-separated list of allowed browser origins. Default shown.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (optional) ---
# Per-client-IP limit on the ask endpoints, in slowapi syntax (e.g. "60/minute",
# "5/second"). Leave empty to disable rate limiting entirely.
RATE_LIMIT=
# Set "true" ONLY when the backend runs behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. the bundled docker-compose nginx). Then the rate-limit
# key is the forwarded client IP instead of the proxy's. Do not enable if the
# backend is reachable directly — clients could spoof the header.
TRUST_PROXY_HEADERS=false

# Per-client-IP limit on register/login/logout/refresh. Unlike RATE_LIMIT above,
# this one is ALWAYS ON (not gated behind that setting) — a login brute-force or
# registration-spam vector shouldn't depend on an opt-in setting. Default shown;
# only relevant once JWT_SECRET is set (those endpoints 400 otherwise).
AUTH_RATE_LIMIT=5/minute

# --- Observability (optional) ---
# OpenTelemetry tracing is off unless an OTLP/HTTP endpoint is set here. Point it
# at any OTLP collector (SigNoz, Grafana Tempo, Jaeger, an OTel Collector, ...).
# Traces include per-request spans enriched with the routing decision
# (ai.mode_used, ai.model, ai.provider).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-orchestrator

# --- Storage (optional) ---
# SQLite database path. Defaults to ai_orchestrator.db in the project root.
DATABASE_PATH=ai_orchestrator.db
